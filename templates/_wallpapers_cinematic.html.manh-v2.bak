    <g fill="var(--man-win-warm)" opacity="0.9">
      <rect x="46" y="340" width="3" height="4"><animate attributeName="opacity" values="0.9;0.1;0.9" dur="7s" begin="0s" repeatCount="indefinite"/></rect>
