      <rect x="286" y="245" width="3" height="4"/><rect x="310" y="245" width="3" height="4"/>
      <rect x="322" y="265" width="3" height="4"/><rect x="298" y="285" width="3" height="4"/>
      <rect x="286" y="305" width="3" height="4"/><rect x="310" y="325" width="3" height="4"/>
      <rect x="356" y="260" width="3" height="4"/><rect x="368" y="260" width="3" height="4"/>
