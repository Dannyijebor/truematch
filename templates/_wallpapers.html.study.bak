{# ============================================================
   CINEMATIC WALLPAPERS — one scene per archetype
   Uses currentColor so accent adapts to theme + light/dark mode
   ============================================================ #}
{% macro wallpaper(key, accent) %}
<div class="chat-wallpaper" data-wallpaper="{{ key }}">
  {% if key == 'executive' %}
  {# ---------- SAVILE · The Chairman · A pocket watch suspended in still air ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet" class="wp-svg wp-savile">
    <defs>
      <radialGradient id="savile-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.20"/>
        <stop offset="60%" stop-color="currentColor" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
      <filter id="savile-soft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="1.2"/>
      </filter>
    </defs>

    <circle cx="250" cy="250" r="230" fill="url(#savile-glow)"/>

    <!-- Outer case -->
    <circle cx="250" cy="250" r="175" fill="none" stroke="currentColor" stroke-width="2"/>
    <circle cx="250" cy="250" r="168" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
    <circle cx="250" cy="250" r="160" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.3"/>

    <!-- Roman numeral hour markers -->
    <g class="savile-markers" font-family="Georgia, serif" font-size="16" fill="currentColor" text-anchor="middle" font-style="italic" opacity="0.75">
      <text x="250" y="108">XII</text>
      <text x="335" y="135">I</text>
      <text x="388" y="190">II</text>
      <text x="400" y="258">III</text>
      <text x="388" y="325">IV</text>
      <text x="335" y="378">V</text>
      <text x="250" y="405">VI</text>
      <text x="165" y="378">VII</text>
      <text x="112" y="325">VIII</text>
      <text x="100" y="258">IX</text>
      <text x="112" y="190">X</text>
      <text x="165" y="135">XI</text>
    </g>

    <!-- Minute tick marks -->
    <g stroke="currentColor" stroke-width="0.6" opacity="0.45">
      <line x1="250" y1="82" x2="250" y2="90"/>
      <line x1="290" y1="90" x2="287" y2="98"/>
      <line x1="325" y1="110" x2="319" y2="116"/>
      <line x1="355" y1="140" x2="347" y2="146"/>
      <line x1="375" y1="180" x2="368" y2="184"/>
      <line x1="388" y1="222" x2="380" y2="224"/>
      <line x1="388" y1="278" x2="380" y2="280"/>
      <line x1="375" y1="320" x2="368" y2="317"/>
      <line x1="355" y1="360" x2="347" y2="356"/>
      <line x1="325" y1="390" x2="319" y2="384"/>
      <line x1="290" y1="410" x2="287" y2="402"/>
      <line x1="210" y1="410" x2="213" y2="402"/>
      <line x1="175" y1="390" x2="181" y2="384"/>
      <line x1="145" y1="360" x2="153" y2="356"/>
      <line x1="125" y1="320" x2="132" y2="317"/>
      <line x1="112" y1="278" x2="120" y2="280"/>
      <line x1="112" y1="222" x2="120" y2="224"/>
      <line x1="125" y1="180" x2="132" y2="184"/>
      <line x1="145" y1="140" x2="153" y2="146"/>
      <line x1="175" y1="110" x2="181" y2="116"/>
      <line x1="210" y1="90" x2="213" y2="98"/>
    </g>

    <!-- Engraved text at top -->
    <text x="250" y="78" font-family="Georgia, serif" font-size="12" fill="currentColor" text-anchor="middle" font-style="italic" opacity="0.55">MMXXVI</text>

    <!-- Hands rotate around the actual center (250,250) -->
    <line x1="250" y1="250" x2="250" y2="145" stroke="currentColor" stroke-width="4" stroke-linecap="round" filter="url(#savile-soft)"><animateTransform attributeName="transform" type="rotate" from="0 250 250" to="360 250 250" dur="60s" repeatCount="indefinite"/></line>
    <line x1="250" y1="250" x2="250" y2="110" stroke="currentColor" stroke-width="2" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 250 250" to="360 250 250" dur="12s" repeatCount="indefinite"/></line>
    <line x1="250" y1="270" x2="250" y2="100" stroke="currentColor" stroke-width="0.7" stroke-linecap="round" opacity="0.65"><animateTransform attributeName="transform" type="rotate" from="0 250 250" to="360 250 250" dur="1.5s" repeatCount="indefinite"/></line>

    <circle cx="250" cy="250" r="7" fill="currentColor"/>
    <circle cx="250" cy="250" r="3" fill="#0d0e12"/>
  </svg>

  {% elif key == 'boardroom' %}
  {# ---------- MANHATTAN · The Rainmaker · A skyline breathing at night ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" class="wp-svg wp-manh">
    <defs>
      <linearGradient id="manh-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.02"/>
        <stop offset="70%" stop-color="currentColor" stop-opacity="0.06"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.12"/>
      </linearGradient>
      <radialGradient id="manh-moon" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="500" height="500" fill="url(#manh-sky)"/>
    <circle cx="380" cy="90" r="55" fill="url(#manh-moon)"/>
    <circle cx="380" cy="90" r="22" fill="currentColor" opacity="0.5"/>

    <!-- Far layer — faded skyline -->
    <g fill="currentColor" opacity="0.25">
      <rect x="20" y="290" width="30" height="180"/>
      <rect x="70" y="250" width="26" height="220"/>
      <rect x="130" y="310" width="34" height="160"/>
      <rect x="200" y="270" width="28" height="200"/>
      <rect x="260" y="320" width="36" height="150"/>
      <rect x="330" y="260" width="30" height="210"/>
      <rect x="400" y="300" width="28" height="170"/>
      <rect x="450" y="280" width="34" height="190"/>
    </g>

    <!-- Mid layer — main buildings -->
    <g fill="currentColor" opacity="0.7">
      <rect x="40" y="220" width="45" height="250"/>
      <rect x="100" y="160" width="55" height="310"/>
      <rect x="170" y="260" width="48" height="210"/>
      <rect x="230" y="120" width="65" height="350"/>
      <rect x="310" y="200" width="55" height="270"/>
      <rect x="380" y="140" width="60" height="330"/>
      <rect x="450" y="230" width="42" height="240"/>
    </g>

    <!-- Window grid on the tall central building -->
    <g class="manh-windows-a" fill="#ffffff" opacity="0.85">
      <rect x="242" y="140" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="140" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="140" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="155" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="155" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="155" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="170" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="170" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="170" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="185" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="185" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="185" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="215" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="215" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="215" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="230" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="230" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="230" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="245" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="245" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="245" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="242" y="260" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="252" y="260" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="262" y="260" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
    </g>

    <!-- Windows on other buildings -->
    <g class="manh-windows-b" fill="#ffffff" opacity="0.7">
      <rect x="110" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="122" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="134" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="110" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="122" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="134" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="110" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="122" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="134" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="110" y="240" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="122" y="240" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="134" y="240" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="390" y="160" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="402" y="160" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="414" y="160" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="390" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="402" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="414" y="180" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="390" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="402" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="414" y="200" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
      <rect x="390" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="402" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect><rect x="414" y="220" width="5" height="7"><animate attributeName="opacity" values="0.85; 0.2; 0.85" dur="4s" repeatCount="indefinite"/></rect>
    </g>

    <!-- Ground haze -->
    <rect x="0" y="450" width="500" height="50" fill="currentColor" opacity="0.15"/>
  </svg>

  {% elif key == 'heritage' %}
  {# ---------- MAYFAIR · The Diplomat · An old estate with drifting fog ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" class="wp-svg wp-mayfair">
    <defs>
      <linearGradient id="mayfair-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.12"/>
      </linearGradient>
      <radialGradient id="mayfair-sun" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="500" height="500" fill="url(#mayfair-sky)"/>
    <circle cx="380" cy="130" r="70" fill="url(#mayfair-sun)"/>
    <circle cx="380" cy="130" r="28" fill="currentColor" opacity="0.4"/>

    <!-- Distant hills -->
    <path d="M0 340 Q100 280 200 320 T400 300 T500 330 V500 H0 Z" fill="currentColor" opacity="0.15"/>

    <!-- Estate main block -->
    <g stroke="currentColor" fill="none" stroke-width="1.2" opacity="0.75">
      <path d="M140 380 V260 L250 190 L360 260 V380 Z"/>
      <path d="M140 380 H360"/>
      <path d="M180 380 V300 H220 V380"/>
      <path d="M280 380 V300 H320 V380"/>
      <line x1="250" y1="190" x2="250" y2="270"/>
      <path d="M230 270 H270"/>
      <line x1="160" y1="285" x2="340" y2="285"/>
    </g>

    <!-- Windows -->
    <g fill="currentColor" opacity="0.4">
      <rect x="160" y="300" width="10" height="14"/>
      <rect x="160" y="330" width="10" height="14"/>
      <rect x="330" y="300" width="10" height="14"/>
      <rect x="330" y="330" width="10" height="14"/>
      <rect x="240" y="300" width="10" height="14"/>
      <rect x="250" y="220" width="0" height="0"/>
    </g>
    <circle cx="250" cy="245" r="6" fill="currentColor" opacity="0.7"/>

    <!-- Chimneys -->
    <rect x="170" y="240" width="8" height="30" fill="currentColor" opacity="0.6"/>
    <rect x="320" y="240" width="8" height="30" fill="currentColor" opacity="0.6"/>

    <!-- Fog layers drifting -->
    <g class="mayfair-fog" fill="currentColor" opacity="0.2">
      <ellipse cx="150" cy="400" rx="160" ry="18"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="350" cy="420" rx="180" ry="22"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="250" cy="440" rx="220" ry="20"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
    </g>

    <!-- Trees -->
    <g fill="currentColor" opacity="0.3">
      <ellipse cx="80" cy="380" rx="30" ry="45"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="80" cy="390" rx="6" ry="25"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="420" cy="380" rx="28" ry="42"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="420" cy="392" rx="6" ry="25"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
    </g>
  </svg>

  {% elif key == 'sovereign' %}
  {# ---------- SOHO · The Founder · A brownstone row at dusk ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" class="wp-svg wp-soho">
    <defs>
      <linearGradient id="soho-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.04"/>
        <stop offset="60%" stop-color="currentColor" stop-opacity="0.1"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.18"/>
      </linearGradient>
      <radialGradient id="soho-sun" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="500" height="500" fill="url(#soho-sky)"/>
    <circle cx="250" cy="300" r="140" fill="url(#soho-sun)"/>

    <!-- Row of townhouses -->
    <g stroke="currentColor" fill="none" stroke-width="1.2" opacity="0.8">
      <path d="M30 380 V220 L90 180 L150 220 V380 Z"/>
      <path d="M150 380 V230 L210 195 L270 230 V380 Z"/>
      <path d="M270 380 V230 L330 195 L390 230 V380 Z"/>
      <path d="M390 380 V240 L450 210 L500 240 V380"/>
    </g>

    <!-- Stoop stairs -->
    <g stroke="currentColor" stroke-width="0.8" opacity="0.6">
      <line x1="70" y1="380" x2="70" y2="345"/>
      <line x1="70" y1="380" x2="110" y2="380"/>
      <line x1="230" y1="380" x2="230" y2="345"/>
      <line x1="230" y1="380" x2="270" y2="380"/>
      <line x1="350" y1="380" x2="350" y2="345"/>
      <line x1="350" y1="380" x2="390" y2="380"/>
    </g>

    <!-- Door and lit windows -->
    <g fill="currentColor">
      <rect x="80" y="330" width="20" height="50" opacity="0.9"/>
      <rect x="190" y="330" width="20" height="50" opacity="0.9"/>
      <rect x="310" y="330" width="20" height="50" opacity="0.9"/>
      <rect x="430" y="340" width="20" height="40" opacity="0.9"/>

      <g class="soho-windows-a" opacity="0.55">
        <rect x="45" y="245" width="16" height="20"/>
        <rect x="75" y="245" width="16" height="20"/>
        <rect x="105" y="245" width="16" height="20"/>
        <rect x="45" y="280" width="16" height="20"/>
        <rect x="75" y="280" width="16" height="20"/>
        <rect x="105" y="280" width="16" height="20"/>
      </g>
      <g class="soho-windows-b" opacity="0.55">
        <rect x="165" y="255" width="16" height="20"/>
        <rect x="195" y="255" width="16" height="20"/>
        <rect x="225" y="255" width="16" height="20"/>
        <rect x="165" y="290" width="16" height="20"/>
        <rect x="195" y="290" width="16" height="20"/>
        <rect x="225" y="290" width="16" height="20"/>
      </g>
      <g class="soho-windows-c" opacity="0.55">
        <rect x="285" y="255" width="16" height="20"/>
        <rect x="315" y="255" width="16" height="20"/>
        <rect x="345" y="255" width="16" height="20"/>
        <rect x="285" y="290" width="16" height="20"/>
        <rect x="315" y="290" width="16" height="20"/>
        <rect x="345" y="290" width="16" height="20"/>
      </g>
    </g>

    <!-- Sidewalk -->
    <rect x="0" y="380" width="500" height="8" fill="currentColor" opacity="0.4"/>
    <rect x="0" y="388" width="500" height="112" fill="currentColor" opacity="0.08"/>
  </svg>

  {% elif key == 'obsidian' %}
  {# ---------- ZURICH · The Analyst · A faceted crystal refracting light ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet" class="wp-svg wp-zurich">
    <defs>
      <radialGradient id="zurich-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <circle cx="250" cy="250" r="200" fill="url(#zurich-glow)"/>

    <g stroke="currentColor" stroke-width="1" fill="none" opacity="0.8">
      <!-- Outer crystalline form -->
      <path d="M250 60 L410 200 L250 440 L90 200 Z"/>
      <path d="M250 60 L410 200 L250 260 L90 200 Z"/>
      <path d="M250 260 L410 200 L250 440"/>
      <path d="M250 260 L90 200 L250 440"/>

      <!-- Inner refracting facets -->
      <g opacity="0.6">
        <path d="M250 130 L320 200 L250 300 L180 200 Z"/>
        <path d="M250 130 L320 200 L250 200 Z" fill="currentColor" opacity="0.15"/>
        <path d="M250 130 L180 200 L250 200 Z" fill="currentColor" opacity="0.08"/>
        <path d="M180 200 L250 300 L250 200 Z" fill="currentColor" opacity="0.12"/>
        <path d="M320 200 L250 300 L250 200 Z" fill="currentColor" opacity="0.2"/>
      </g>

      <!-- Extra sparkle lines -->
      <g class="zurich-sparkle" stroke-width="0.5" opacity="0.4">
        <path d="M250 40 L250 100"/>
        <path d="M420 200 L360 200"/>
        <path d="M250 460 L250 400"/>
        <path d="M80 200 L140 200"/>
      </g>
    </g>

    <circle cx="250" cy="200" r="4" fill="currentColor"/>
  </svg>

  {% elif key == 'bordeaux' %}
  {# ---------- KYOTO · The Strategist · Cherry blossoms over still water ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" class="wp-svg wp-kyoto">
    <defs>
      <linearGradient id="kyoto-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.03"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.1"/>
      </linearGradient>
      <radialGradient id="kyoto-moon" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="500" height="500" fill="url(#kyoto-sky)"/>
    <circle cx="400" cy="100" r="60" fill="url(#kyoto-moon)"/>
    <circle cx="400" cy="100" r="26" fill="currentColor" opacity="0.45"/>

    <!-- Distant mountain silhouette -->
    <path d="M0 300 L120 220 L200 280 L290 200 L400 280 L500 240 V500 H0 Z" fill="currentColor" opacity="0.15"/>

    <!-- Torii gate on the mountain ridge -->
    <g stroke="currentColor" stroke-width="2" fill="none" opacity="0.5">
      <line x1="230" y1="220" x2="230" y2="270"/>
      <line x1="270" y1="220" x2="270" y2="270"/>
      <line x1="215" y1="228" x2="285" y2="228"/>
      <line x1="220" y1="245" x2="280" y2="245"/>
    </g>

    <!-- Still water reflection band -->
    <rect x="0" y="330" width="500" height="170" fill="currentColor" opacity="0.05"/>
    <g class="kyoto-ripples" stroke="currentColor" stroke-width="0.4" fill="none" opacity="0.3">
      <path d="M0 350 Q125 345 250 350 T500 350"/>
      <path d="M0 380 Q125 375 250 380 T500 380"/>
      <path d="M0 410 Q125 405 250 410 T500 410"/>
      <path d="M0 440 Q125 435 250 440 T500 440"/>
      <path d="M0 470 Q125 465 250 470 T500 470"/>
    </g>

    <!-- Falling petals — many, varied size and delay -->
    <g class="kyoto-petals" fill="currentColor" opacity="0.85">
      <ellipse cx="40" cy="60" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="120" cy="30" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="200" cy="80" rx="6.5" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="290" cy="50" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="360" cy="100" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="440" cy="70" rx="5.5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="80" cy="150" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="180" cy="180" rx="5.5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="270" cy="140" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="350" cy="200" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="60" cy="270" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="150" cy="320" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="240" cy="290" rx="6.5" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="330" cy="350" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="420" cy="290" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="100" cy="400" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="210" cy="430" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="310" cy="460" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="420" cy="420" rx="6" ry="3.5"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="40" cy="470" rx="5" ry="3"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
    </g>
  </svg>

  {% elif key == 'editorial' %}
  {# ---------- ASPEN · The Curator · A gallery wall with soft shifting light ---------- #}
  <svg viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" class="wp-svg wp-aspen">
    <defs>
      <linearGradient id="aspen-light" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.25"/>
        <stop offset="50%" stop-color="currentColor" stop-opacity="0"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.1"/>
      </linearGradient>
      <radialGradient id="aspen-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Soft gallery wall -->
    <rect width="500" height="500" fill="url(#aspen-light)"/>
    <circle cx="250" cy="220" r="200" fill="url(#aspen-halo)"/>

    <!-- Framed artwork #1 (large) -->
    <g stroke="currentColor" fill="none" stroke-width="1.6" opacity="0.75">
      <rect x="110" y="100" width="180" height="240"/>
      <rect x="122" y="112" width="156" height="216"/>
    </g>
    <!-- Inner geometric abstraction -->
    <g stroke="currentColor" fill="none" stroke-width="0.6" opacity="0.5">
      <circle cx="200" cy="200" r="40"/>
      <circle cx="200" cy="200" r="28"/>
      <line x1="160" y1="270" x2="240" y2="270"/>
      <line x1="160" y1="285" x2="240" y2="285"/>
      <line x1="160" y1="300" x2="220" y2="300"/>
    </g>

    <!-- Framed artwork #2 (small) -->
    <g stroke="currentColor" fill="none" stroke-width="1.2" opacity="0.6">
      <rect x="310" y="180" width="110" height="140"/>
      <rect x="320" y="190" width="90" height="120"/>
      <circle cx="365" cy="250" r="20"/>
      <path d="M320 290 L365 260 L410 290"/>
    </g>

    <!-- Floor line -->
    <line x1="0" y1="400" x2="500" y2="400" stroke="currentColor" stroke-width="0.8" opacity="0.4"/>
    <rect x="0" y="400" width="500" height="100" fill="currentColor" opacity="0.06"/>

    <!-- Potted plant silhouette -->
    <g fill="currentColor" opacity="0.35">
      <path d="M400 400 L440 400 L432 450 L408 450 Z"/>
      <ellipse cx="420" cy="360" rx="18" ry="42"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="408" cy="370" rx="12" ry="32"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
      <ellipse cx="432" cy="372" rx="12" ry="32"><animateTransform attributeName="transform" type="translate" values="0 0; -25 180; -10 380" dur="12s" repeatCount="indefinite"/></ellipse>
    </g>
  </svg>
  {% endif %}
</div>
{% endmacro %}
